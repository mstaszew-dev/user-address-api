{
  "name": "user-address-api-frontend",
  "version": "1.0.0",
  "description": "TypeScript frontend for the UserAddress API dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main/resources/static/ts/app.ts --bundle --minify --outfile=src/main/resources/static/js/app.js",
    "build:watch": "esbuild src/main/resources/static/ts/app.ts --bundle --watch --outfile=src/main/resources/static/js/app.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/main/resources/static/ts src/test/frontend",
    "lint:fix": "eslint src/main/resources/static/ts src/test/frontend --fix",
    "format": "prettier --write \"src/main/resources/static/ts/**/*.ts\" \"src/test/frontend/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"src/main/resources/static/ts/**/*.ts\" \"src/test/frontend/**/*.ts\" \"*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^2.1.0",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vitest": "^0.5.4",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true
  }
}
